# Configuracion de la API
# Copia este archivo como .env y ajusta los valores con los tuyos.

PORT=10000

# MongoDB en linea (MongoDB Atlas)
# 1. Crear un cluster gratuito M0 en https://www.mongodb.com/cloud/atlas
# 2. Crear un usuario de base de datos en Database Access
# 3. Permitir el acceso desde la red en Network Access
# 4. Copiar la cadena de conexion desde Connect > Drivers
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/rest_api?retryWrites=true&w=majority
