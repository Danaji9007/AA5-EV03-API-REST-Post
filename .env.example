# Configuracion local de la API
# Copia este archivo como .env y ajusta los valores.

PORT=10000

# MongoDB en linea (MongoDB Atlas / mLab)
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/rest_api?retryWrites=true&w=majority

# MongoDB local (XAMPP / instalacion local)
MONGODB_URI=mongodb://127.0.0.1:27017/rest_api
